---
import Base from '../../layouts/Base.astro';
---
<Base title="Admin" noindex={true}>
  <div class="wrap admin">
    <section id="login" hidden>
      <h1>Sign in</h1>
      <form id="login-form">
        <label>Email
          <input type="email" id="email" required autocomplete="username" />
        </label>
        <label>Password
          <input type="password" id="password" required autocomplete="current-password" />
        </label>
        <button type="submit">Sign in</button>
        <p id="login-msg" class="msg" role="alert"></p>
      </form>
    </section>

    <section id="dashboard" hidden>
      <div class="admin-head">
        <h1>Manage projects</h1>
        <button id="signout" class="ghost" type="button">Sign out</button>
      </div>

      <h2>Create a project</h2>
      <form id="project-form">
        <label>Project name
          <input type="text" id="title" required maxlength="120" />
        </label>
        <div class="row">
          <label>Location
            <input type="text" id="location" maxlength="80" />
          </label>
          <label>Year
            <input type="number" id="year" min="1990" max="2100" inputmode="numeric" />
          </label>
          <label>Type of work
            <input type="text" id="category" list="categories" maxlength="60" />
            <datalist id="categories">
              <option value="Building"></option>
              <option value="Road"></option>
              <option value="Drainage"></option>
              <option value="Bridge"></option>
              <option value="Water supply"></option>
              <option value="Renovation"></option>
            </datalist>
          </label>
        </div>
        <label>Description
          <textarea id="description" maxlength="3000"></textarea>
          <span class="hint">Leave a blank line between paragraphs.</span>
        </label>
        <button id="submit-btn" type="submit">Create project</button>
        <p id="status" class="msg" role="status"></p>
      </form>

      <h2>Your projects</h2>
      <p class="hint">Open a project to add photos and videos. A new project stays hidden until you choose Show on site.</p>
      <p id="list-status" class="msg" role="status"></p>
      <div id="project-list"></div>
    </section>
  </div>
</Base>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { poster } from '../../lib/media.js';

  const cloud = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
  const imagePreset = import.meta.env.PUBLIC_CLOUDINARY_IMAGE_PRESET;
  const videoPreset = import.meta.env.PUBLIC_CLOUDINARY_VIDEO_PRESET || imagePreset;
  const MAX_VIDEO_MB = 100;

  const $ = (id) => document.getElementById(id);
  const el = (tag, props = {}, ...kids) => {
    const node = Object.assign(document.createElement(tag), props);
    node.append(...kids);
    return node;
  };
  const flash = (msg) => { $('list-status').textContent = msg; };
  const openIds = new Set(); // keeps projects expanded after the list refreshes

  const slugify = (s) =>
    s.toLowerCase().normalize('NFKD').replace(/[^\w\s-]/g, '').trim()
      .replace(/[\s_]+/g, '-').replace(/-+/g, '-').slice(0, 60) || 'project';

  // Resize photos in the browser so big phone shots stay under Cloudinary's free file limit.
  async function shrink(file, max = 1920) {
    if (!file.type.startsWith('image/') || file.type === 'image/gif') return file;
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, max / Math.max(bmp.width, bmp.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bmp.width * scale);
    canvas.height = Math.round(bmp.height * scale);
    canvas.getContext('2d').drawImage(bmp, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
    return new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' });
  }

  async function upload(file) {
    const isVideo = file.type.startsWith('video/');
    if (isVideo && file.size > MAX_VIDEO_MB * 1024 * 1024) {
      throw new Error(`${file.name} is over ${MAX_VIDEO_MB} MB. Trim or compress it, then try again.`);
    }
    const body = new FormData();
    body.append('file', isVideo ? file : await shrink(file));
    body.append('upload_preset', isVideo ? videoPreset : imagePreset);
    const res = await fetch(`https://api.cloudinary.com/v1_1/${cloud}/${isVideo ? 'video' : 'image'}/upload`, {
      method: 'POST',
      body,
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error?.message || `Could not upload ${file.name}.`);
    return {
      type: isVideo ? 'video' : 'image',
      public_id: json.public_id,
      url: json.secure_url,
      width: json.width ?? null,
      height: json.height ?? null,
    };
  }

  // Small preview used in the admin lists.
  const thumb = (m) =>
    m.type === 'video'
      ? m.url.replace('/upload/', '/upload/so_0,f_jpg,q_auto,c_fill,ar_3:2,w_300/').replace(/\.[a-z0-9]+$/i, '.jpg')
      : m.url.replace('/upload/', '/upload/f_auto,q_auto,c_fill,ar_3:2,g_auto,w_300/');

  // The first photo is the cover; if there are only videos, use the first video's frame.
  const pickCover = (items) => {
    const firstImage = items.find((m) => m.type === 'image');
    if (firstImage) return firstImage.url;
    return items[0] ? poster(items[0].url) : null;
  };

  function renderProject(p, items) {
    const details = el('details', { className: 'proj', open: openIds.has(p.id) });
    details.addEventListener('toggle', () => (details.open ? openIds.add(p.id) : openIds.delete(p.id)));

    const count = `${items.length} ${items.length === 1 ? 'file' : 'files'}`;
    const summary = el('summary', {},
      el('span', { className: 'name', textContent: p.title }),
      el('span', { className: 'state', textContent: `${p.published ? 'Visible' : 'Hidden'}, ${count}` })
    );

    // Project actions
    const toggle = el('button', { type: 'button', className: 'ghost', textContent: p.published ? 'Hide from site' : 'Show on site' });
    toggle.addEventListener('click', async () => {
      const { error } = await supabase.from('projects').update({ published: !p.published }).eq('id', p.id);
      openIds.add(p.id);
      await loadProjects();
      flash(error ? 'Could not update the project.' : 'Saved. The live site updates in a minute or two.');
    });

    const del = el('button', { type: 'button', className: 'ghost', textContent: 'Delete project' });
    del.addEventListener('click', async () => {
      if (!confirm(`Delete "${p.title}" and all its photos and videos from the site? This cannot be undone.`)) return;
      const { error } = await supabase.from('projects').delete().eq('id', p.id);
      openIds.delete(p.id);
      await loadProjects();
      flash(error ? 'Could not delete the project.' : 'Deleted. The live site updates in a minute or two.');
    });

    const projActions = el('div', { className: 'proj-actions' }, toggle, del);

    // Media in this project
    const mediaBlock = items.length
      ? el('ul', { className: 'mgrid' })
      : el('p', { className: 'hint', textContent: 'No files yet. Add photos and videos below.' });

    for (const m of items) {
      const isCover = p.cover_url === m.url || p.cover_url === poster(m.url);
      const tag = m.type === 'video' ? 'Video' : isCover ? 'Cover photo' : 'Photo';
      const actions = el('span', { className: 'mactions' });

      if (m.type === 'image' && !isCover) {
        const cover = el('button', { type: 'button', className: 'ghost', textContent: 'Make cover' });
        cover.addEventListener('click', async () => {
          const { error } = await supabase.from('projects').update({ cover_url: m.url }).eq('id', p.id);
          openIds.add(p.id);
          await loadProjects();
          flash(error ? 'Could not change the cover.' : 'Cover updated. The live site updates in a minute or two.');
        });
        actions.append(cover);
      }

      const remove = el('button', { type: 'button', className: 'ghost', textContent: 'Remove' });
      remove.addEventListener('click', async () => {
        if (!confirm('Remove this file from the project?')) return;
        const { error } = await supabase.from('project_media').delete().eq('id', m.id);
        if (!error) {
        const remaining = items.filter((x) => x.id !== m.id);
        await supabase
          .from('projects')
          .update(isCover ? { cover_url: pickCover(remaining) } : { published: p.published })
          .eq('id', p.id);
      }
        openIds.add(p.id);
        await loadProjects();
        flash(error ? 'Could not remove the file.' : 'Removed. The live site updates in a minute or two.');
      });
      actions.append(remove);

      mediaBlock.append(
        el('li', {},
          el('img', { src: thumb(m), alt: '', width: 300, height: 200, loading: 'lazy' }),
          el('span', { className: 'tag', textContent: tag }),
          actions
        )
      );
    }

    // Add files to this project
    const note = el('p', { className: 'msg' });
    note.setAttribute('role', 'status');
    const input = el('input', { type: 'file', accept: 'image/*,video/*', multiple: true });
    const send = el('button', { type: 'button', textContent: 'Upload to this project' });
    send.addEventListener('click', async () => {
      const files = [...input.files];
      if (!files.length) {
        note.textContent = 'Choose at least one photo or video.';
        return;
      }
      send.disabled = true;
      try {
        const uploaded = [];
        for (let i = 0; i < files.length; i++) {
          note.textContent = `Uploading ${i + 1} of ${files.length}: ${files[i].name}`;
          uploaded.push(await upload(files[i]));
        }
        note.textContent = 'Saving...';
        const start = items.reduce((max, m) => Math.max(max, m.sort_order ?? 0), -1) + 1;
        const { error } = await supabase.from('project_media').insert(
          uploaded.map((u, i) => ({ project_id: p.id, ...u, sort_order: start + i }))
        );
        if (error) throw error;
        await supabase
        .from('projects')
        .update(p.cover_url ? { published: p.published } : { cover_url: pickCover(uploaded) })
        .eq('id', p.id);
        openIds.add(p.id);
        await loadProjects();
        flash('Added. The live site updates in a minute or two.');
      } catch (err) {
        note.textContent = err.message || 'Something went wrong. Try again.';
        send.disabled = false;
      }
    });

    const adder = el('div', { className: 'adder' },
      el('label', {}, 'Add photos and videos', input,
        el('span', { className: 'hint', textContent: 'Choose as many as you like. Photos are resized automatically. Keep each video under 100 MB, ideally 15 to 60 seconds.' })
      ),
      send,
      note
    );

    details.append(summary, el('div', { className: 'proj-body' }, projActions, mediaBlock, adder));
    return details;
  }

  async function loadProjects() {
    const list = $('project-list');
    const [projectsRes, mediaRes] = await Promise.all([
      supabase.from('projects').select('id,title,published,cover_url,created_at').order('created_at', { ascending: false }),
      supabase.from('project_media').select('*').order('sort_order'),
    ]);
    list.replaceChildren();
    if (projectsRes.error || mediaRes.error) {
      list.textContent = 'Could not load projects. Refresh the page and try again.';
      return;
    }
    if (!projectsRes.data.length) {
      list.append(el('p', { className: 'hint', textContent: 'No projects yet. Create your first one above.' }));
      return;
    }
    for (const p of projectsRes.data) {
      list.append(renderProject(p, mediaRes.data.filter((m) => m.project_id === p.id)));
    }
  }

  function render(session) {
    $('login').hidden = !!session;
    $('dashboard').hidden = !session;
    if (session) loadProjects();
  }

  // Fires once with the current session on load, then on every sign-in or sign-out.
  supabase.auth.onAuthStateChange((_event, session) => {
    setTimeout(() => render(session), 0);
  });

  $('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('login-msg').textContent = '';
    const { error } = await supabase.auth.signInWithPassword({
      email: $('email').value.trim(),
      password: $('password').value,
    });
    if (error) $('login-msg').textContent = 'The email or password is incorrect.';
  });

  $('signout').addEventListener('click', () => supabase.auth.signOut());

  $('project-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const status = $('status');
    const button = $('submit-btn');
    button.disabled = true;
    status.textContent = 'Creating project...';
    try {
      const title = $('title').value.trim();
      const row = {
        title,
        slug: slugify(title),
        description: $('description').value.trim() || null,
        location: $('location').value.trim() || null,
        year: $('year').value ? parseInt($('year').value, 10) : null,
        category: $('category').value.trim() || null,
        published: false,
      };

      let { data, error } = await supabase.from('projects').insert(row).select('id').single();
      if (error?.code === '23505') {
        // Another project already uses this slug; add a short suffix and retry once.
        row.slug += '-' + Math.random().toString(36).slice(2, 6);
        ({ data, error } = await supabase.from('projects').insert(row).select('id').single());
      }
      if (error) throw error;

      openIds.add(data.id);
      form.reset();
      await loadProjects();
      status.textContent = 'Project created. Open it below to add photos and videos.';
      $('project-list').firstElementChild?.scrollIntoView({ block: 'nearest' });
    } catch (err) {
      status.textContent = err.message || 'Could not create the project. Try again.';
    } finally {
      button.disabled = false;
    }
  });
</script>