---
import Base from '../layouts/Base.astro';
import { supabase } from '../lib/supabase.js';
import { img, srcset, og } from '../lib/media.js';
import { site } from '../config.js';

const [projectsRes, mediaRes] = await Promise.all([
  supabase
    .from('projects')
    .select('id,title,slug,location,year,category,cover_url')
    .eq('published', true)
    .order('created_at', { ascending: false }),
  supabase.from('project_media').select('project_id,type'),
]);
if (projectsRes.error) throw new Error(`Could not load projects: ${projectsRes.error.message}`);
if (mediaRes.error) throw new Error(`Could not load media: ${mediaRes.error.message}`);

const projects = projectsRes.data ?? [];

// Count photos and videos per project for the card tags.
const counts = {};
for (const m of mediaRes.data ?? []) {
  const c = (counts[m.project_id] ??= { photos: 0, videos: 0 });
  if (m.type === 'video') c.videos++;
  else c.photos++;
}
const plural = (n, one) => `${n} ${one}${n === 1 ? '' : 's'}`;
const fileLine = (id) => {
  const c = counts[id];
  if (!c) return '';
  return [c.photos && plural(c.photos, 'photo'), c.videos && plural(c.videos, 'video')].filter(Boolean).join(', ');
};

const [hero] = projects;
const categories = [...new Set(projects.map((p) => p.category?.trim()).filter(Boolean))].sort();
const places = new Set(projects.map((p) => p.location?.trim().toLowerCase()).filter(Boolean)).size;
const years = projects.map((p) => p.year).filter(Boolean);
const facts = [
  projects.length && ['Projects', projects.length],
  places && ['Locations', places],
  years.length && ['Active since', Math.min(...years)],
].filter(Boolean);

const heroCells = hero
  ? [['Latest project', hero.title], ['Location', hero.location], ['Year', hero.year], ['Type', hero.category]].filter(([, v]) => v)
  : [];

// Disciplines: each may be a plain string or { title, text, icon }.
const icons = {
  civil: '<path d="M3 21h18M5 21V9l7-5 7 5v12M10 21v-6h4v6M9 11h.01M15 11h.01M9 14h.01M15 14h.01"/>',
  electrical: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  mechanical: '<path d="M18.48 10.74 L21.33 10.85 L21.33 13.15 L18.48 13.26 L17.47 15.69 L19.41 17.79 L17.79 19.41 L15.69 17.47 L13.26 18.48 L13.15 21.33 L10.85 21.33 L10.74 18.48 L8.31 17.47 L6.21 19.41 L4.59 17.79 L6.53 15.69 L5.52 13.26 L2.67 13.15 L2.67 10.85 L5.52 10.74 L6.53 8.31 L4.59 6.21 L6.21 4.59 L8.31 6.53 L10.74 5.52 L10.85 2.67 L13.15 2.67 L13.26 5.52 L15.69 6.53 L17.79 4.59 L19.41 6.21 L17.47 8.31Z"/><circle cx="12" cy="12" r="2.6"/>',
};
const iconFor = (s) => {
  const key = (s.icon ?? s.title ?? '').toLowerCase();
  if (key.includes('civil')) return icons.civil;
  if (key.includes('electr')) return icons.electrical;
  return icons.mechanical;
};
const services = (site.services ?? []).map((s) => (typeof s === 'string' ? { title: s } : s));

const about = site.about ?? [];
const owner = site.owner;
const hasAbout = about.length > 0 || !!owner;

const base = (site.siteUrl ?? '').replace(/\/$/, '');
const wa = `https://wa.me/${site.whatsapp}${site.whatsappMessage ? `?text=${encodeURIComponent(site.whatsappMessage)}` : ''}`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.tagline,
  email: site.email,
  telephone: site.phone,
  address: site.location,
  ...(base && { url: base }),
};
---
<Base description={site.tagline} image={hero?.cover_url ? og(hero.cover_url) : undefined}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

  <section class="hero">
    {hero?.cover_url ? (
      <div class="hero-bg" aria-hidden="true">
        <picture>
          <source
            media="(min-width: 900px)"
            srcset={srcset(hero.cover_url, [1200, 1600, 2000, 2400], '2:1')}
            sizes="100vw"
          />
          <img
            src={img(hero.cover_url, 900, '4:5')}
            srcset={srcset(hero.cover_url, [600, 900, 1200], '4:5')}
            sizes="100vw"
            width="900"
            height="1125"
            alt=""
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    ) : (
      <svg class="hero-mark" viewBox="11 28 79 45.5" aria-hidden="true"><use href="#qs-mark" /></svg>
    )}
    <div class="hero-shade"></div>

    <div class="wrap">
      <div class="hero-grid">
        <div>
          <h1 class="rise" style="--i:0">{site.headline ?? site.role}</h1>
          {site.intro && <p class="lead rise" style="--i:1">{site.intro}</p>}
          <div class="cta-row rise" style="--i:2">
            <a class="btn btn-primary" href="#projects">View projects</a>
            <a class="btn btn-light" href={wa}>Message on WhatsApp</a>
          </div>
        </div>
        {facts.length > 0 && (
          <dl class="schedule rise" style="--i:3" aria-label="Work at a glance">
            {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        )}
      </div>

      {hero && (
        <a class="hero-latest" href={`/projects/${hero.slug}/`} aria-label={`Open project: ${hero.title}`}>
          <dl class="titleblock">
            {heroCells.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            <div class="tb-open"><dt>{fileLine(hero.id) || 'Project'}</dt><dd>Open project</dd></div>
          </dl>
        </a>
      )}
    </div>

    <svg class="cut cut-bottom" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
      <polygon points="0,7.6 100,0.6 100,3 0,10" fill="#fe5100" />
      <polygon points="0,10 100,3 100,10" fill="#f1f3f4" />
    </svg>
  </section>

  {services.length > 0 && (
    <section class="section" id="services" aria-labelledby="services-title" style="padding-block:clamp(2rem,5vw,3.5rem) clamp(0.5rem,2vw,1.5rem)">
      <div class="wrap">
        <div class="section-head"><h2 id="services-title">What we do</h2></div>
        <ul class="svc-list">
          {services.map((s) => (
            <li class="svc">
              <span class="svc-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={iconFor(s)} />
              </span>
              <h3>{s.title}</h3>
              {s.text && <p>{s.text}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section projects" id="projects" aria-labelledby="projects-title">
    <svg class="cut cut-top" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
      <polygon points="0,0 100,0 0,10" fill="#f1f3f4" />
    </svg>
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-title">Projects</h2>
        {categories.length > 1 && (
          <div class="filters" id="filters" role="group" aria-label="Filter projects by type" hidden>
            <button type="button" class="filter" data-filter="all" aria-pressed="true">All</button>
            {categories.map((c) => <button type="button" class="filter" data-filter={c} aria-pressed="false">{c}</button>)}
          </div>
        )}
      </div>

      {projects.length ? (
        <div class="grid" id="grid">
          {projects.map((p, i) => (
            <a class="card" href={`/projects/${p.slug}/`} data-type={p.category?.trim() ?? ''}>
              <span class="card-media">
                {p.cover_url ? (
                  <img
                    src={img(p.cover_url, 800, '4:3')}
                    srcset={srcset(p.cover_url, [400, 800, 1200], '4:3')}
                    sizes="(min-width: 960px) 33vw, (min-width: 620px) 50vw, 100vw"
                    width="800"
                    height="600"
                    alt=""
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : <span class="ph" style="display:block"></span>}
                {p.category && <span class="card-chip">{p.category}</span>}
              </span>
              <span class="card-body">
                <h3>{p.title}</h3>
                {[p.location, p.year].filter(Boolean).length > 0 && (
                  <span class="card-meta">{[p.location, p.year].filter(Boolean).join(', ')}</span>
                )}
                {fileLine(p.id) && (
                  <ul class="card-tags"><li>{fileLine(p.id)}</li></ul>
                )}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">No projects have been published yet. Check back soon.</p>
      )}
      <p class="sr-only" id="filter-status" role="status"></p>
    </div>
    <svg class="cut cut-bottom" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
      <polygon points="0,10 100,10 100,0" fill="#ffffff" />
    </svg>
  </section>

  {hasAbout && (
    <section class="section about" id="about" aria-labelledby="about-title">
      <div class={`wrap about-grid${owner ? ' has-owner' : ''}`}>
        <div class="about-copy">
          <h2 id="about-title">About</h2>
          {about.map((p) => <p>{p}</p>)}
        </div>
        {owner && (
          <figure class="owner">
            {owner.photo && (
              <img src={owner.photo} width="372" height="477" alt={`Portrait of ${owner.name}`} loading="lazy" decoding="async" />
            )}
            <figcaption>
              <strong>{owner.name}</strong>
              <span>{owner.title}</span>
            </figcaption>
          </figure>
        )}
      </div>
    </section>
  )}

  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <svg class="contact-mark" viewBox="11 28 79 45.5" aria-hidden="true"><use href="#qs-mark" /></svg>
    <div class="wrap contact-grid">
      <div>
        <h2 id="contact-title">{site.contactHeadline ?? 'Have a project in mind?'}</h2>
        <p>{site.contactText ?? 'Tell us about the site, the scope and your timeline, and we will get back to you.'}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={wa}>Message on WhatsApp</a>
          <a class="btn" href={`mailto:${site.email}`}>Send an email</a>
        </div>
      </div>
      <dl class="contact-list">
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Phone</dt><dd><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></dd></div>
        {site.location && <div><dt>Address</dt><dd>{site.location}</dd></div>}
        {site.rc && <div><dt>Registration</dt><dd>{site.rc}</dd></div>}
      </dl>
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement: the type filter only appears when JavaScript is running.
  const bar = document.getElementById('filters');
  if (bar) {
    bar.hidden = false;
    const chips = bar.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('#grid [data-type]');
    const status = document.getElementById('filter-status');
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter;
        let shown = 0;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        cards.forEach((card) => {
          const match = f === 'all' || card.dataset.type === f;
          card.hidden = !match;
          if (match) shown++;
        });
        status.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}${f === 'all' ? '' : ` of type ${f}`}.`;
      })
    );
  }
</script>